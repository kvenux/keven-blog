{
  "type": "object",
  "additionalProperties": false,
  "required": ["article", "topics", "concepts", "claims", "relations", "keywords"],
  "properties": {
    "article": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "title", "summary", "stance"],
      "properties": {
        "slug": { "type": "string" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "stance": { "type": "string" }
      }
    },
    "topics": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "weight"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "weight": { "type": "number" }
        }
      }
    },
    "concepts": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "role", "weight", "summary"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "role": { "type": "string", "enum": ["central", "supporting", "mentioned"] },
          "weight": { "type": "number" },
          "summary": { "type": "string" }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "importance", "confidence", "status", "concepts"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "importance": { "type": "string", "enum": ["core", "supporting", "side"] },
          "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
          "status": { "type": "string", "enum": ["active", "revised", "rejected"] },
          "concepts": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "target", "type", "reason"],
        "properties": {
          "source": { "type": "string" },
          "target": { "type": "string" },
          "type": { "type": "string", "enum": ["extends", "supports", "contradicts", "revises", "depends_on", "applies_to", "example_of", "summarizes", "contrasts_with", "related_to"] },
          "reason": { "type": "string" }
        }
      }
    },
    "keywords": {
      "type": "array",
      "minItems": 8,
      "items": { "type": "string" }
    }
  }
}
